{
  "_about": [
    "Rules for single-path (linear) dungeons: the player starts at IN.",
    "distance = [min, max] tiles walked from 'from' (default: the start); null = no max.",
    "Rule fields on a marker type (distance, prefer, pick...) are defaults for its rules; a rule's own value wins.",
    "prefer: tile tags (and off_route/dead_end), tried in order; tagged tiles without a marker come first."
  ],
  "strategy": "standard",
  "marker_types": {
    "start":     {"color": "#2850dc"},
    "console":   {"color": "#28b450", "size": "small", "objective": true, "distance": [1, 16], "prefer": ["large"]},
    "spawn":     {"color": "#dc2828", "size": "small", "distance": [1, 16], "prefer": ["small", "large"]},
    "loot":      {"color": "#dc8c28", "size": "small", "distance": [0, 16], "prefer": ["small", "medium"]},
    "discovery": {"color": "#dc8c28", "size": "small", "label": "?"}
  },
  "markers": [
    {"type": "console", "count": 1, "distance": [3, null], "pick": "random"},
    {"type": "spawn", "distance": [1, 2]},
    {"type": "spawn", "distance": [6, 11]},
    {"type": "spawn", "distance": [13, 16]},
    {"type": "loot", "count": 3, "distance": [1, null], "pick": "spread", "spread_from": ["start", "spawn", "loot"]},
    {"type": "discovery", "count": 0, "pick": "spread"}
  ]
}
